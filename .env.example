# AWS Credentials for Bedrock
aws_access_key_id=your_aws_access_key_id_here
aws_secret_access_key=your_aws_secret_access_key_here
aws_session_token=your_aws_session_token_here_if_using_temporary_credentials
AWS_REGION=us-east-1

# Optional: OpenAI API Key (if using OpenAI embeddings instead of Bedrock)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: LangSmith (for debugging and tracing)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=de-interview-prep
